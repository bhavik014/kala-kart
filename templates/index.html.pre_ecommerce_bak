        // Play voice using native audio file stream first, falling back to Web Speech Synthesis
        function playVoice(text, directAudioUrl = null) {
            if (currentActiveAudio) {
                currentActiveAudio.pause();
                currentActiveAudio.currentTime = 0;
            }

            if (directAudioUrl) {
                currentActiveAudio = new Audio(directAudioUrl);
                currentActiveAudio.play().catch(e => {
                    console.log("Audio URL play note:", e);
                    speakWithWebSpeech(text);
                });
                return;
            }

            // If text is provided, try Bhashini TTS endpoint for streaming audio
            if (text) {
                const formData = new URLSearchParams();
                formData.append('text', text);
                formData.append('language', currentLang);
                fetch('/api/gov/bhashini/tts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                }).then(res => res.json()).then(data => {
                    if (data.audio_url) {
                        currentActiveAudio = new Audio(data.audio_url);
                        currentActiveAudio.play().catch(() => speakWithWebSpeech(text));
                    } else {
                        speakWithWebSpeech(text);
                    }
                }).catch(() => speakWithWebSpeech(text));
            }
        }

        // Play product voice note from card
        function playProductVoice(productId) {
            const product = cachedProducts.find(p => p.id === productId);
            if (!product) return;

            const audioUrl = product.audio_url;
            const text = currentLang === 'en' ? (product.story_en || product.title) : (product.story_hi || product.title_hi || product.title);

            const icon = document.getElementById(`icon-play-${productId}`);
            const btn = document.getElementById(`btn-play-${productId}`);
            
            if (currentActiveAudio && !currentActiveAudio.paused) {
                currentActiveAudio.pause();
                currentActiveAudio.currentTime = 0;
                if (icon) icon.setAttribute('data-lucide', 'volume-2');
                lucide.createIcons();
                return;
            }

            if (icon) icon.setAttribute('data-lucide', 'volume-x');
            lucide.createIcons();

            if (audioUrl) {
                currentActiveAudio = new Audio(audioUrl);
                currentActiveAudio.onended = () => {
                    if (icon) icon.setAttribute('data-lucide', 'volume-2');
                    lucide.createIcons();
                };
                currentActiveAudio.play().catch(() => {
                    speakWithWebSpeech(text, () => {
                        if (icon) icon.setAttribute('data-lucide', 'volume-2');
                        lucide.createIcons();
                    });
                });
            } else {
                speakWithWebSpeech(text, () => {
                    if (icon) icon.setAttribute('data-lucide', 'volume-2');
                    lucide.createIcons();
                });
            }
        }

