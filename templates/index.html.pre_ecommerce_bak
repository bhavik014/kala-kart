                    if (el) {
                        el.classList.replace('bg-[#fefae0]', 'bg-[#c2593f]');
                        el.classList.replace('text-[#2b2d42]', 'text-white');
                    }
                }
                const filtered = cachedProducts.filter(p => p.category === cat);
                renderBuyerMarketplace(filtered);
            }
            lucide.createIcons();
        }

        // Toggle Modal helper
        function toggleModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('hidden');
        }

        // =========================================================================
        // LIVE GOI OPEN APIS & BACKEND INSPECTOR RUNNER
        // =========================================================================
        let lastPayloadJson = "";

        
        // =========================================================================
        // DYNAMIC FAIR PRICING CALCULATION ENGINE (GOVERNMENT OPEN STANDARDS)
        // =========================================================================
        async function triggerDynamicPricingRecalc() {
            const cat = document.getElementById('artisan-craft-select').value;
            const days = document.getElementById('pricing-labor-days').value;
            const complexity = document.getElementById('pricing-complexity').value;

            try {
                const formData = new URLSearchParams();
                formData.append('craft_category', cat);
                formData.append('labor_days', days);
                formData.append('complexity', complexity);
                formData.append('weight_grams', '850');
                formData.append('gi_certified', 'true');
                formData.append('sfurti_grade', 'Grade A+');

                const res = await fetch('/api/gov/pricing/predict-fair-price', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });
                const data = await res.json();
                if (data.status === 'success') {
                    document.getElementById('dyn-predicted-price').innerText = `₹${data.suggested_fair_price.toLocaleString()}`;
                    document.getElementById('dyn-price-range').innerText = `(सीमा: ${data.price_range})`;
                    document.getElementById('dyn-artisan-payout').innerText = `✓ कारीगर प्रत्यक्ष भुगतान: ₹${data.cost_breakdown.direct_artisan_payout.toLocaleString()} (${data.cost_breakdown.artisan_direct_share_pct} सीधा बैंक खाता)`;
                    document.getElementById('artisan-price-input').value = data.suggested_fair_price;
                }
            } catch (e) {
                console.error("Dynamic pricing calculation error:", e);
            }
        }

        async function runGoIInspector(service) {
            const methodEl = document.getElementById('insp-method');
            const urlEl = document.getElementById('insp-url');
            const statusEl = document.getElementById('insp-status');
            const latencyEl = document.getElementById('insp-latency');
            const payloadEl = document.getElementById('insp-payload');

            payloadEl.innerText = "Executing live call to National GoI Gateway...";
            const startTime = performance.now();

            try {
                let url = "/api/gov/status";
                let method = "GET";
                let body = null;

                if (service === 'bhashini') {
                    url = "/api/gov/bhashini/translate";
                    method = "POST";
                    body = new URLSearchParams({
                        text: "85% Direct to Artisan",
                        source_lang: "en",
                        target_lang: "hi"
                    });
                } else if (service === 'vishwakarma') {
                    url = "/api/gov/pm-vishwakarma/verify";
                    method = "POST";
                    body = new URLSearchParams({
                        vishwakarma_id: "PMV-BH-88214"
                    });
                } else if (service === 'indiapost') {
                    url = "/api/gov/indiapost/track/SP-IN-88210-BH";
                    method = "GET";
                } else if (service === 'ondc') {
                    url = "/api/gov/ondc/search";
                    method = "POST";
                    body = new URLSearchParams({
                        category: "Handicrafts"
                    });
                } else if (service === 'sfurti') {
                    url = "/api/gov/sfurti/cfc-verify/SFURTI-CFC-77291";
                    method = "GET";
                } else if (service === 'fairprice') {
                    url = "/api/gov/pricing/predict-fair-price";
                    method = "POST";
                    body = new URLSearchParams({
                        craft_category: "Handicrafts & Painting",
                        labor_days: "4.0",
                        complexity: "intricate",
                        weight_grams: "850",
                        gi_certified: "true",
                        sfurti_grade: "Grade A+"
                    });
                }

                methodEl.innerText = method;
                urlEl.innerText = url;

                const options = { method };
                if (body) {
                    options.body = body;
                    options.headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
                }

                const res = await fetch(url, options);
                const elapsed = Math.round(performance.now() - startTime);
                const data = await res.json();

                statusEl.innerText = `${res.status} OK`;
                statusEl.className = "text-emerald-400 font-bold";
                latencyEl.innerText = `Latency: ${elapsed}ms`;
                lastPayloadJson = JSON.stringify(data, null, 2);
                payloadEl.innerText = lastPayloadJson;
            } catch (err) {
                statusEl.innerText = "ERR";
                statusEl.className = "text-rose-400 font-bold";
                payloadEl.innerText = `Error connecting to backend: ${err.message}`;
            }
        }

        function copyInspectorPayload() {
            if (lastPayloadJson) {
                navigator.clipboard.writeText(lastPayloadJson);
                alert("JSON Response copied to clipboard!");
            }
        }

        // Initialize App on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            fetchProducts();
            lucide.createIcons();
            // Automatically test GoI status in inspector
            runGoIInspector('status');
        });
    </script>
</body>
</html>
