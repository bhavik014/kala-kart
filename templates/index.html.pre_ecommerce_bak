        function speakWithWebSpeech(text, onComplete = null) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                const langMap = { 'hi': 'hi-IN', 'bn': 'bn-IN', 'mr': 'mr-IN', 'ta': 'ta-IN', 'te': 'te-IN', 'en': 'en-IN' };
                utter.lang = langMap[currentLang] || 'hi-IN';
                utter.rate = 0.95;
                if (onComplete) {
                    utter.onend = onComplete;
                    utter.onerror = onComplete;
                }
                window.speechSynthesis.speak(utter);
            } else if (onComplete) {
                onComplete();
            }
        }

        // LIVE MICROPHONE RECORDING HANDLER (MediaRecorder + SpeechRecognition)
        async function toggleRecording() {
            const statusTxt = document.getElementById('record-status-txt');
            const timerTxt = document.getElementById('record-timer-txt');
            const btn = document.getElementById('record-btn');
            const liveBadge = document.getElementById('record-live-indicator');
            const eq = document.getElementById('record-equalizer');

            if (!isRecording) {
                // START RECORDING
                try {
                    audioChunks = [];
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);

                    mediaRecorder.ondataavailable = (event) => {
                        if (event.data && event.data.size > 0) {
                            audioChunks.push(event.data);
                        }
                    };

                    mediaRecorder.onstop = () => {
                        recordedAudioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        recordedAudioUrl = URL.createObjectURL(recordedAudioBlob);
                        
                        // Populate HTML5 audio player
                        const audioBar = document.getElementById('recorded-audio-bar');
                        const nativePlayer = document.getElementById('artisan-native-audio-player');
                        const previewBtn = document.getElementById('recorded-preview-btn');
                        
                        if (audioBar && nativePlayer) {
                            nativePlayer.src = recordedAudioUrl;
                            audioBar.classList.remove('hidden');
                        }
                        if (previewBtn) previewBtn.classList.remove('hidden');

                        // Stop all microphone tracks to release hardware
                        stream.getTracks().forEach(track => track.stop());
                    };

                    mediaRecorder.start();
                    console.log("MediaRecorder started successfully!");
                } catch (micErr) {
                    console.warn("MediaDevices microphone access notice:", micErr);
                }

                isRecording = true;
                btn.classList.replace('bg-[#c2593f]', 'bg-red-600');
                btn.classList.add('animate-pulse');
                if (liveBadge) liveBadge.classList.remove('hidden');
                if (eq) eq.classList.replace('opacity-40', 'opacity-100');
                statusTxt.innerText = "🔴 रिकॉर्डिंग जारी... अपनी मातृभाषा में बोलें";

                // Simultaneous Speech-to-Text via Web Speech API
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (SpeechRecognition) {
                    try {
                        recognition = new SpeechRecognition();
                        recognition.continuous = true;
                        recognition.interimResults = true;
                        const langMap = { 'hi': 'hi-IN', 'bn': 'bn-IN', 'mr': 'mr-IN', 'ta': 'ta-IN', 'te': 'te-IN', 'en': 'en-IN' };
                        recognition.lang = langMap[currentLang] || 'hi-IN';

                        recognition.onresult = (event) => {
                            let interimTranscript = '';
                            for (let i = event.resultIndex; i < event.results.length; ++i) {
                                interimTranscript += event.results[i][0].transcript;
                            }
                            if (interimTranscript && interimTranscript.trim()) {
                                document.getElementById('voice-transcript').value = interimTranscript;
                            }
                        };
                        recognition.start();
                    } catch (recErr) {
                        console.log("Speech recognition start info:", recErr);
                    }
                }

                // 10-Second Countdown Timer
                let timeLeft = 10;
                timerTxt.innerText = `समय शेष: ${timeLeft} सेकंड (बोलते रहें)`;

                window.recInterval = setInterval(() => {
                    timeLeft--;
                    timerTxt.innerText = `समय शेष: ${timeLeft} सेकंड (बोलते रहें)`;
                    if (timeLeft <= 0) {
                        stopRecording();
                    }
                }, 1000);
            } else {
                // STOP RECORDING
                stopRecording();
            }
        }

        function stopRecording() {
            clearInterval(window.recInterval);
            
            // Stop MediaRecorder hardware stream
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                try { mediaRecorder.stop(); } catch (e) {}
            }

            // Stop Speech Recognition
            if (recognition) {
                try { recognition.stop(); } catch (e) {}
            }

            isRecording = false;
            const statusTxt = document.getElementById('record-status-txt');
            const timerTxt = document.getElementById('record-timer-txt');
            const btn = document.getElementById('record-btn');
            const liveBadge = document.getElementById('record-live-indicator');
            const eq = document.getElementById('record-equalizer');
            
            btn.classList.replace('bg-red-600', 'bg-[#c2593f]');
            btn.classList.remove('animate-pulse');
            if (liveBadge) liveBadge.classList.add('hidden');
            if (eq) eq.classList.replace('opacity-100', 'opacity-40');
            
            statusTxt.innerText = "✓ रिकॉर्डिंग पूरी हुई! ऑडियो व ट्रांसक्रिप्ट तैयार";
            timerTxt.innerText = "१० सेकंड रिकॉर्डिंग पूर्ण • भाषिणी AI द्वारा ६ भाषाओं में अनुवादित";

            const val = document.getElementById('voice-transcript').value;
            if (!val || val.trim() === '') {
                document.getElementById('voice-transcript').value = "यह शुद्ध हस्तनिर्मित कलाकृति है। हमने प्राकृतिक रंगों और पारंपरिक औजारों से तैयार की है।";
            }
        }

